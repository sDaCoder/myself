---
import LinkPill, { type Link } from './LinkPill.astro';
import github from '../assets/social/github.png';
import safari from '../assets/icons/safari.png';
import pdf from '../assets/icons/pdf.png';
import youtube from '../assets/icons/youtube.png';
import Slide from './Slide.astro';
import Stack from './Stack.astro';

interface Project {
	name: string;
	summary: string;
	links: Link[];
	points: string[];
	stack: string[];
}

const projects: Project[] = [
	{
		name: 'Recon AI',
		summary: 'Reconciles merchant transactions, payment-provider settlements and bank statements, then explains every mismatch.',
		links: [
			{ label: 'Repository', icon: github, href: 'https://github.com/sDaCoder/reconai' },
			{ label: 'Live website', icon: safari, href: 'https://reconai-one.vercel.app/' },
		],
		points: ['Finds discrepancies across three financial sources.', 'A QA agent analyses the reason behind each discrepancy.'],
		stack: ['LangChain', 'FastAPI', 'Postgres', 'OpenAI'],
	},
	{
		name: 'CurioGenius AI',
		summary: 'A business development pod: four agents (business, designer, developer, testing) working one brief.',
		links: [{ label: 'Repository', icon: github, href: 'https://github.com/sDaCoder/business-development-pod' }],
		points: ['Vector search maintains the user persona.', 'AWS DynamoDB integration, with the FastAPI backend deployed on AWS EC2.'],
		stack: ['Multi-agent', 'Vector search', 'FastAPI', 'DynamoDB', 'AWS EC2'],
	},
	{
		name: 'Smart Home Server',
		summary: 'An IoT web server for home appliances, with an ESP32 acting as the Wi-Fi access point.',
		// The resume's repo link looks wrong (PRODUCT.md); keep it pending until confirmed.
		links: [{ label: 'Repository', icon: github, href: 'https://github.com/sDaCoder/esp32-server' }],
		points: [
			'Node.js backend controlling appliances remotely.',
			'MQTT protocol for bidirectional communication.',
			'JWT-based user authentication for verified API access.',
		],
		stack: ['ESP32', 'MQTT', 'Node.js', 'JWT'],
	},
	{
		name: '3-Channel Audio Equalizer',
		summary: 'An analog equalizer that splits audio into low, mid and high bands, shapes each one, then mixes them back together. A group project for the IIT Madras Electronic Systems Project (EE3999), 2026.',
		links: [{ label: 'Project report', icon: pdf, href: 'https://drive.google.com/file/d/17eQLmG0jtUNECalPdGTQ2ziDRzZIwglq/view' }],
		points: [
			'Three op-amp multiple-feedback band-pass filters.',
			'An inverting summing amplifier recombines the bands; a 2.5 V reference biases the single-supply circuit.',
			'Simulated in LTspice and checked against the derived transfer function in MATLAB for centre frequency, bandwidth and Quality Factor.',
		],
		stack: ['Op-amps', 'Active filters', 'LTspice', 'MATLAB'],
	},
	{
		name: 'PixelLab',
		summary: 'Treats an image as a 2D signal and runs it through Mean, Gaussian and Laplacian filters to compare smoothing against edge enhancement. An IIT Madras BS Electronic Systems project, 2026.',
		links: [
			{ label: 'Repository', icon: github, href: 'https://github.com/sDaCoder/filter-studio-flow' },
			{ label: 'Live website', icon: safari, href: 'https://filter-studio-flow.supravadutta-nnhs-kol-e2321.workers.dev/' },
			{ label: 'Project demo', icon: youtube, href: 'https://youtu.be/njWlDf2GVbI' },
			{ label: 'Project report', icon: pdf, href: 'https://drive.google.com/file/d/1lxzDxu1-dFIsqZHyEa3_zMvYojsQcJ2E/view' },
		],
		points: [
			'Mean and Gaussian kernels act as low-pass filters that suppress noise; the Laplacian, a second-order derivative, is a high-pass filter that sharpens edges.',
			'Grayscale images are convolved with 3×3 kernels in the spatial domain, pixel by pixel.',
			'The Gaussian filter gave the best balance between noise reduction and detail preservation.',
		],
		stack: ['Signal processing', 'Image filtering', 'Convolution', 'Spatial domain'],
	},
];
---

<Slide id="projects" title="Agents that" accent="do the work." lead="Five builds: two agent systems, a device server, an analog equalizer and an image-filtering lab.">
	<div class="relative">
		<div class="pointer-events-none absolute -top-[60px] -left-[180px] -z-[1] size-[520px] rounded-full bg-saffron opacity-[.32] blur-[80px]" aria-hidden="true"></div>
		<div class="pointer-events-none absolute top-[45%] -right-[200px] -z-[1] size-[520px] rounded-full bg-marigold opacity-[.32] blur-[80px]" aria-hidden="true"></div>
		{
			projects.map((project) => (
				<article class="grid grid-cols-1 items-start gap-[clamp(24px,5vw,80px)] border-t border-hairline py-11 stage:grid-cols-[minmax(0,6fr)_minmax(0,5fr)]" data-scroll-item>
					<div data-scroll="slide">
						<h3 class="m-0 text-[clamp(38px,5vw,72px)] leading-[.95] font-extrabold tracking-[-.04em]">{project.name}</h3>
						<p class="mt-3.5 mb-0 stage:max-w-[36ch] text-[clamp(18px,1.6vw,22px)] leading-[1.4] text-ivory-muted">{project.summary}</p>
						<div class="mt-[18px] flex flex-wrap gap-2">
							{project.links.map((link) => <LinkPill {...link} />)}
						</div>
					</div>
					<div class="lg rounded-panel px-6 py-[22px]" data-scroll="rise">
						<ul class="m-0 grid list-none gap-3 p-0">
							{project.points.map((point) => (
								<li class="spec-dot grid grid-cols-[22px_1fr] gap-1.5 text-base leading-[1.45] text-ivory">{point}</li>
							))}
						</ul>
						<Stack items={project.stack} divided />
					</div>
				</article>
			))
		}
	</div>
</Slide>

