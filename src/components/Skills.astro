---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import anthropic from '../assets/certs/anthropic.png';
import coursera from '../assets/certs/coursera.png';
import udemy from '../assets/certs/udemy.png';
import Slide from './Slide.astro';

/** The last item in each group is joined with a quiet "and". */
const groups = [
	{ label: 'Agents', items: ['LangChain', 'LangGraph', 'RAG', 'BM25', 'Redis'] },
	{ label: 'Languages', items: ['Python', 'Java', 'C', 'C++', 'JavaScript', 'SQL'] },
	{ label: 'Backend', items: ['FastAPI', 'Express', 'MongoDB', 'Postgres'] },
	{ label: 'Cloud', items: ['AWS', 'boto3', 'DynamoDB', 'EC2'] },
	{ label: 'Web', items: ['React', 'Next.js', 'Figma'] },
	{ label: 'Hardware', items: ['ESP32', 'Arduino', 'Embedded C'] },
];

const certs = [
	{ issuer: 'Anthropic', icon: anthropic, name: 'Model Context Protocol', href: 'https://verify.skilljar.com/c/8ffyqwasvccp' },
	{ issuer: 'Coursera', icon: coursera, name: 'Spring Boot', href: 'https://www.coursera.org/account/accomplishments/verify/YL0YG7POCOB9' },
	{ issuer: 'Udemy', icon: udemy, name: 'Full Stack Web Development', href: 'https://www.udemy.com/certificate/UC-5150e81f-9f67-4494-8d9d-606d1579a663/' },
];
---

<Slide id="skills" title="The toolkit.">
	<div class="reveal grid grid-cols-1 gap-x-12 gap-y-10 stage:grid-cols-3">
		{
			groups.map(({ label, items }) => (
				<div>
					<h3 class="m-0 mb-3 text-[13px] font-semibold tracking-[.06em] text-ivory-faint uppercase">{label}</h3>
					<p class="m-0 text-[clamp(22px,2.2vw,30px)] leading-[1.34] font-semibold tracking-[-.02em]">
						{items.slice(0, -1).join(', ')} <span class="font-normal text-ivory-faint">and</span> {items.at(-1)}
					</p>
				</div>
			))
		}
	</div>
	<div class="reveal mt-16 grid grid-cols-1 gap-3.5 stage:grid-cols-3">
		{
			certs.map((cert) => (
				<a
					class="lg grid grid-cols-[auto_minmax(0,1fr)] items-center gap-x-3.5 gap-y-1 rounded-card py-5 pr-[22px] pl-4 no-underline transition-transform duration-[350ms] ease-out-expo hover:-translate-y-0.5"
					href={cert.href}
					target="_blank"
					rel="noopener"
				>
					<Image src={cert.icon} alt="" widths={[48, 96, 144]} sizes="48px" class="row-span-2 size-12" />
					<small class="text-[13px] font-semibold text-ivory-faint">{cert.issuer}</small>
					<strong class="flex items-center justify-between gap-2.5 text-[19px] tracking-[-.01em]">
						{cert.name} <Icon name="arrow" />
					</strong>
				</a>
			))
		}
	</div>
</Slide>
