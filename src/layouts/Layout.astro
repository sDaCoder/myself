---
import { Font } from 'astro:assets';
import Icons from '../components/Icons.astro';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Suprava Dutta · Software engineer',
	description = 'Suprava Dutta designs multi-agent LLM systems (orchestration, intent routing, retrieval) and the servers and boards underneath them.',
} = Astro.props;

// social crawlers need absolute URLs
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}og-image.jpg`, Astro.site);
const ogImageAlt = 'Suprava Dutta in an orange T-shirt beneath the name in large type, with a dock of portfolio sections below.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0b0806" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Suprava Dutta" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="canonical" href={pageUrl} />
		<!-- the Skills dock icon (Cool Finder) -->
		<link rel="icon" type="image/png" sizes="192x192" href={`${import.meta.env.BASE_URL}favicon.png`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="48x48" />
		<link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
		<meta name="generator" content={Astro.generator} />
		<Font cssVariable="--font-hanken" preload />
		<Font cssVariable="--font-spline-mono" />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<Icons />
		<slot />
		<script>
			import '../scripts/stage';
			import '../scripts/scroll-in';
		</script>
	</body>
</html>
